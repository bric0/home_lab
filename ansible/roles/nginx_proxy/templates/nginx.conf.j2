# Managed by Ansible

events {
    worker_connections 256;
}

# Layer 4 - SNI routing on port 443
stream {
    map $ssl_preread_server_name $backend {
        vpn.bricoo.fr        headscale;
        files.bricoo.fr   local_https;
        pwd.bricoo.fr        local_https;
        adguard.bricoo.fr    local_https;
        pve-01.bricoo.fr     local_https;
        default              local_https;
    }

    upstream headscale {
        server 10.30.0.10:8080;
    }

    upstream local_https {
        server 127.0.0.1:8443;
    }

    server {
        listen 443;
        ssl_preread on;
        proxy_pass $backend;
    }
}

# Layer 7 - TLS termination + reverse proxy
http {
    server {
        listen 8443 ssl;
        server_name portainer.bricoo.fr;

        ssl_certificate /etc/nginx/certs/live/portainer.bricoo.fr/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/live/portainer.bricoo.fr/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        location / {
            proxy_pass https://{{ portainer_server_ip }}:9443;
            proxy_ssl_verify off;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }

    server {
        listen 8443 ssl;
        server_name pwd.bricoo.fr;

        ssl_certificate /etc/nginx/certs/live/pwd.bricoo.fr/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/live/pwd.bricoo.fr/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        location / {
            proxy_pass http://10.40.0.10:8001;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }

    server {
        listen 8443 ssl;
        server_name adguard.bricoo.fr;

        ssl_certificate /etc/nginx/certs/live/adguard.bricoo.fr/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/live/adguard.bricoo.fr/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        location / {
            proxy_pass http://127.0.0.1:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }

    server {
        listen 8443 ssl;
        server_name files.bricoo.fr;

        ssl_certificate /etc/nginx/certs/live/files.bricoo.fr/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/live/files.bricoo.fr/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        client_max_body_size 512M;

        location / {
            proxy_pass http://10.40.0.10:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }

    server {
        listen 8443 ssl;
        server_name pve-01.bricoo.fr;

        ssl_certificate /etc/nginx/certs/live/pve-01.bricoo.fr/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/live/pve-01.bricoo.fr/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        location / {
            proxy_pass https://192.168.10.1:8006;
            proxy_ssl_verify off;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }
}
