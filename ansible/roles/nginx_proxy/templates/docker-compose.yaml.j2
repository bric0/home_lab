# Managed by Ansible
services:
  nginx:
    image: nginx:{{ nginx_proxy_nginx_version }}-alpine
    container_name: nginx-proxy
    restart: unless-stopped
    network_mode: host
    volumes:
      - {{ nginx_proxy_data_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ nginx_proxy_data_dir }}/certs:/etc/nginx/certs:ro

  certbot-renew:
    image: certbot/dns-cloudflare:v{{ nginx_proxy_certbot_version }}
    container_name: certbot-renew
    restart: unless-stopped
    network_mode: host
    volumes:
      - {{ nginx_proxy_data_dir }}/certs:/etc/letsencrypt
      - {{ nginx_proxy_data_dir }}/cloudflare.ini:/etc/cloudflare.ini:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    entrypoint: /bin/sh
    command: >
      -c "apk add --no-cache docker-cli &&
      while true; do
        certbot renew --dns-cloudflare --dns-cloudflare-credentials /etc/cloudflare.ini
          --deploy-hook 'docker exec nginx-proxy nginx -s reload';
        sleep 12h;
      done"
