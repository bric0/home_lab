#!/usr/sbin/nft -f
# Managed by Ansible - Firewall inter-VLAN rules

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        ct state established,related accept
        iif lo accept
        iifname "tailscale0" accept comment "VPN Tailscale"

        tcp dport 22 accept comment "SSH"
        icmp type echo-request accept comment "Ping"

        # Accept traffic from VLANs to the gateway
{% for vlan in firewall_vlans %}
        iifname "eth0.{{ vlan.id }}" accept comment "VLAN {{ vlan.id }}"
{% endfor %}

        # Accept traffic from management interface
        iifname "eth1" accept comment "Management"
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept

        # Allow DNATed traffic to reach its destination
        ct status dnat accept comment "DNATed traffic"

        # All VLANs -> DMZ (VLAN 10) for DNS
        iifname "eth0.*" oifname "eth0.10" tcp dport 53 accept comment "DNS TCP to DMZ"
        iifname "eth0.*" oifname "eth0.10" udp dport 53 accept comment "DNS UDP to DMZ"

        # DHCP relay: VLAN 40 (prod) -> DMZ (VLAN 10) for DHCP
        iifname "eth0.40" oifname "eth0.10" udp dport 67 accept comment "DHCP relay to AdGuard"
        iifname "eth0.10" oifname "eth0.40" udp dport 68 accept comment "DHCP relay response"

        # DMZ -> INFRA for reverse proxy to Portainer
        iifname "eth0.10" oifname "eth0.30" tcp dport 9443 accept comment "Reverse proxy to Portainer"
        # DMZ -> INFRA for VPN passthrough to Headscale
        iifname "eth0.10" oifname "eth0.30" tcp dport 8080 accept comment "VPN passthrough to Headscale"

        # Admin VLAN (20) -> all VLANs
        iifname "eth0.20" oifname "eth0.*" accept comment "Admin full access"

        # VPN Tailscale -> all VLANs
        iifname "tailscale0" accept comment "VPN full access"

        # All VLANs -> internet via management interface
        iifname "eth0.*" oifname "eth1" accept comment "Internet access"
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority 100; policy accept;

        oifname "eth1" masquerade comment "NAT to internet"
    }

    chain prerouting {
        type nat hook prerouting priority -100; policy accept;
{% for rule in firewall_dnat_rules %}

        # {{ rule.comment }}
        iifname "{{ rule.iif }}" {{ rule.proto }} dport {{ rule.dport }} dnat to {{ rule.dest }}
{% endfor %}
    }
}
